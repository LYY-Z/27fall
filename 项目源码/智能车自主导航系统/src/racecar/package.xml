<?xml version="1.0"?>
<package format="3">
  <name>racecar</name>
  <version>0.0.1</version>
  <description>Racecar ROS2 package</description>
  <maintainer email="user@todo.todo">TODO: Maintainer</maintainer>
  <license>TODO: License</license>
  
  <buildtool_depend>ament_cmake</buildtool_depend>
  
